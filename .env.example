# Backend API base URL (must include `/api`, do NOT include `/v1`)
# Local:      http://localhost:3210/api  (match backend PORT + API_PREFIX)
# Production: https://api.prismacv.com/api
NEXT_PUBLIC_API_URL=http://localhost:3210/api

# Optional logger level (defaults to debug in development, info in production)
LOG_LEVEL=debug

# Sentry monitoring (optional)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
